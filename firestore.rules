rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
    
    // Global helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }
    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Blueprint validations
    function isValidLocation(data) {
      return data.keys().hasAll(['name', 'type', 'lat', 'lng']) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
             data.type is string && data.type.size() > 0 && data.type.size() <= 50 &&
             data.lat is number &&
             data.lng is number;
    }
    function isValidRequest(data) {
       return data.keys().hasAll(['actionType', 'data', 'status', 'createdBy', 'createdAt']) &&
              data.actionType is string && data.actionType.size() <= 10 &&
              data.status is string && data.status.size() <= 20 &&
              data.createdBy is string && data.createdBy.size() <= 128 &&
              data.createdAt is string && data.createdAt.size() <= 50;
    }

    match /locations/{locationId} {
      allow read: if isValidId(locationId);
      allow list: if true;
      allow create: if isAdmin() && isValidLocation(incoming());
      allow update: if isAdmin() && isValidId(locationId) && isValidLocation(incoming());
      allow delete: if isAdmin() && isValidId(locationId);
    }

    match /requests/{requestId} {
      allow read: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(requestId) && isValidRequest(incoming()) && incoming().createdBy == request.auth.uid && incoming().status == 'pending';
      allow update: if isAdmin() && isValidId(requestId) && incoming().diff(existing()).affectedKeys().hasOnly(['status']);
      allow delete: if isAdmin();
    }
    
    match /users/{userId} {
      allow read: if isSignedIn();
      allow update, create: if isAdmin() && incoming().keys().hasAll(['role', 'email']);
      allow delete: if isAdmin();
    }
  }
}
